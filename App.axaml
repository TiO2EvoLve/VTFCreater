<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VTFCreater.App"
             xmlns:local="using:VTFCreater"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Styles>
            <!-- 标题栏 -->
            <Style Selector="Border.titlebar">
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="BorderBrush" Value="#20FFFFFF" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style Selector="Border.app-icon">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#FF7A45" Offset="0" />
                            <GradientStop Color="#FA541C" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style Selector="TextBlock.app-title">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.92" />
            </Style>

            <!-- 导航标签 -->
            <Style Selector="Button.nav-tab">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.nav-tab:pointerover">
                <Setter Property="Background" Value="#15FFFFFF" />
                <Setter Property="Opacity" Value="0.95" />
            </Style>
            <Style Selector="Button.nav-tab.active">
                <Setter Property="Background" Value="#25FA541C" />
                <Setter Property="Foreground" Value="#FA541C" />
                <Setter Property="Opacity" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 窗口控制按钮 -->
            <Style Selector="Button.window-btn">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.window-btn.min">
                <Setter Property="Background" Value="#FAAD14" />
            </Style>
            <Style Selector="Button.window-btn.max">
                <Setter Property="Background" Value="#52C41A" />
            </Style>
            <Style Selector="Button.window-btn.close">
                <Setter Property="Background" Value="#FF4D4F" />
            </Style>
            <Style Selector="Button.window-btn:pointerover">
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <!-- 主内容区 -->
            <Style Selector="Border.main-content">
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="BorderBrush" Value="#22FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- 卡片 -->
            <Style Selector="Border.card">
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="BorderBrush" Value="#28FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style Selector="Border.log-card">
                <Setter Property="MinHeight" Value="240" />
            </Style>

            <!-- 文字样式 -->
            <Style Selector="TextBlock.section-title">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style Selector="TextBlock.page-subtitle">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style Selector="TextBlock.field-label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>

            <Style Selector="TextBlock.path-text">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.88" />
            </Style>

            <Style Selector="TextBlock.format-badge">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FA541C" />
            </Style>

            <Style Selector="TextBlock.hint-text">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.5" />
            </Style>

            <Style Selector="TextBlock.status-text">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#52C41A" />
                <Setter Property="Opacity" Value="0.9" />
            </Style>

            <Style Selector="TextBlock.log-line">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <!-- 按钮 -->
            <Style Selector="Button.primary">
                <Setter Property="Background" Value="#FA541C" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.primary:pointerover">
                <Setter Property="Background" Value="#FF7A45" />
            </Style>
            <Style Selector="Button.primary:disabled">
                <Setter Property="Opacity" Value="0.45" />
            </Style>

            <Style Selector="Button.secondary">
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="BorderBrush" Value="#35FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style Selector="Button.secondary:pointerover">
                <Setter Property="Background" Value="#30FFFFFF" />
            </Style>

            <Style Selector="Button.browse">
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="BorderBrush" Value="#35FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- 输入框 -->
            <Style Selector="TextBox">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="Background" Value="#10FFFFFF" />
            </Style>

            <Style Selector="ComboBox">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <!-- 后缀列表 -->
            <Style Selector="ListBox.suffix-list">
                <Setter Property="Background" Value="#10FFFFFF" />
                <Setter Property="BorderBrush" Value="#28FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </Styles>
    </Application.Styles>
</Application>
